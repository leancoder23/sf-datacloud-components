<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Test flow to validate Data Cloud Query List action integration. Accepts FirstName, LastName, Email and AccountId (page recordId), displays a styled confirmation screen, and creates a Contact record linked to the Account.</description>
    <formulas>
        <name>formulaHeaderText</name>
        <dataType>String</dataType>
        <expression>"&lt;div style=&apos;background: linear-gradient(135deg, #1b96ff 0%, #0b5cab 100%); border-radius: 8px; padding: 20px; margin-bottom: 16px;&apos;&gt;" &amp;
"&lt;p style=&apos;color: #ffffff; font-size: 16px; font-weight: 700; margin: 0 0 4px 0;&apos;&gt;&#128203; Create New Contact&lt;/p&gt;" &amp;
"&lt;p style=&apos;color: rgba(255,255,255,0.85); font-size: 13px; margin: 0;&apos;&gt;Review the details below and confirm to create the contact record.&lt;/p&gt;" &amp;
"&lt;/div&gt;"</expression>
    </formulas>
    <formulas>
        <name>formulaReceivedDataText</name>
        <dataType>String</dataType>
        <expression>"&lt;div style=&apos;background: #f4f6f9; border: 1px solid #d8dde6; border-radius: 8px; padding: 16px; margin-bottom: 16px;&apos;&gt;" &amp;
"&lt;p style=&apos;font-size: 13px; font-weight: 700; color: #3e3e3c; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 12px 0; border-bottom: 1px solid #d8dde6; padding-bottom: 8px;&apos;&gt;Data Received from Data Cloud&lt;/p&gt;" &amp;
"&lt;table style=&apos;width:100%; border-collapse:collapse;&apos;&gt;" &amp;
"&lt;tr&gt;&lt;td style=&apos;padding: 6px 8px; color: #706e6b; font-size: 12px; width: 35%;&apos;&gt;First Name&lt;/td&gt;&lt;td style=&apos;padding: 6px 8px; font-weight: 600; font-size: 13px;&apos;&gt;" &amp; IF(ISBLANK({!firstName}), "&lt;span style=&apos;color:#b0adab; font-style:italic;&apos;&gt;Not provided&lt;/span&gt;", {!firstName}) &amp; "&lt;/td&gt;&lt;/tr&gt;" &amp;
"&lt;tr&gt;&lt;td style=&apos;padding: 6px 8px; color: #706e6b; font-size: 12px;&apos;&gt;Last Name&lt;/td&gt;&lt;td style=&apos;padding: 6px 8px; font-weight: 600; font-size: 13px;&apos;&gt;" &amp; IF(ISBLANK({!lastName}), "&lt;span style=&apos;color:#b0adab; font-style:italic;&apos;&gt;Not provided&lt;/span&gt;", {!lastName}) &amp; "&lt;/td&gt;&lt;/tr&gt;" &amp;
"&lt;tr&gt;&lt;td style=&apos;padding: 6px 8px; color: #706e6b; font-size: 12px;&apos;&gt;Email&lt;/td&gt;&lt;td style=&apos;padding: 6px 8px; font-weight: 600; font-size: 13px;&apos;&gt;" &amp; IF(ISBLANK({!email}), "&lt;span style=&apos;color:#b0adab; font-style:italic;&apos;&gt;Not provided&lt;/span&gt;", {!email}) &amp; "&lt;/td&gt;&lt;/tr&gt;" &amp;
"&lt;tr&gt;&lt;td style=&apos;padding: 6px 8px; color: #706e6b; font-size: 12px;&apos;&gt;Account ID&lt;/td&gt;&lt;td style=&apos;padding: 6px 8px; font-weight: 600; font-size: 13px;&apos;&gt;" &amp; IF(ISBLANK({!accountId}), "&lt;span style=&apos;color:#b0adab; font-style:italic;&apos;&gt;Not on Account page&lt;/span&gt;", {!accountId}) &amp; "&lt;/td&gt;&lt;/tr&gt;" &amp;
"&lt;/table&gt;" &amp;
"&lt;/div&gt;"</expression>
    </formulas>
    <formulas>
        <name>formulaEditSectionHeader</name>
        <dataType>String</dataType>
        <expression>"&lt;div style=&apos;margin-bottom: 4px;&apos;&gt;" &amp;
"&lt;p style=&apos;font-size: 13px; font-weight: 700; color: #3e3e3c; text-transform: uppercase; letter-spacing: 0.5px; margin: 0; border-bottom: 1px solid #d8dde6; padding-bottom: 8px;&apos;&gt;Contact Details&lt;/p&gt;" &amp;
"&lt;p style=&apos;font-size: 12px; color: #706e6b; margin: 8px 0 0 0;&apos;&gt;Edit the fields below if needed before creating the contact.&lt;/p&gt;" &amp;
"&lt;/div&gt;"</expression>
    </formulas>
    <formulas>
        <name>formulaSuccessText</name>
        <dataType>String</dataType>
        <expression>"&lt;div style=&apos;text-align: center; padding: 24px 16px;&apos;&gt;" &amp;
"&lt;div style=&apos;background: #ecfaf0; border: 1px solid #91db8b; border-radius: 50%; width: 64px; height: 64px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;&apos;&gt;" &amp;
"&lt;span style=&apos;font-size: 32px;&apos;&gt;&#9989;&lt;/span&gt;" &amp;
"&lt;/div&gt;" &amp;
"&lt;p style=&apos;font-size: 18px; font-weight: 700; color: #2e844a; margin: 0 0 8px 0;&apos;&gt;Contact Created Successfully!&lt;/p&gt;" &amp;
"&lt;p style=&apos;font-size: 14px; color: #3e3e3c; margin: 0 0 20px 0;&apos;&gt;A new contact record has been created and linked to the account.&lt;/p&gt;" &amp;
"&lt;div style=&apos;background: #f4f6f9; border: 1px solid #d8dde6; border-radius: 8px; padding: 16px; display: inline-block; text-align: left; min-width: 280px;&apos;&gt;" &amp;
"&lt;table style=&apos;width:100%; border-collapse:collapse;&apos;&gt;" &amp;
"&lt;tr&gt;&lt;td style=&apos;padding: 4px 8px; color: #706e6b; font-size: 12px; width: 35%;&apos;&gt;Name&lt;/td&gt;&lt;td style=&apos;padding: 4px 8px; font-weight: 600; font-size: 13px;&apos;&gt;" &amp; {!inputFirstName} &amp; " " &amp; {!inputLastName} &amp; "&lt;/td&gt;&lt;/tr&gt;" &amp;
"&lt;tr&gt;&lt;td style=&apos;padding: 4px 8px; color: #706e6b; font-size: 12px;&apos;&gt;Email&lt;/td&gt;&lt;td style=&apos;padding: 4px 8px; font-weight: 600; font-size: 13px;&apos;&gt;" &amp; IF(ISBLANK({!inputEmail}), "&lt;span style=&apos;color:#b0adab;&apos;&gt;—&lt;/span&gt;", {!inputEmail}) &amp; "&lt;/td&gt;&lt;/tr&gt;" &amp;
"&lt;/table&gt;" &amp;
"&lt;/div&gt;" &amp;
"&lt;/div&gt;"</expression>
    </formulas>
    <interviewLabel>DCQR Test Create Contact From Data {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DCQR_Test_Create_Contact_From_Data</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>createContact</name>
        <label>Create Contact</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>screenSuccess</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>accountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>inputEmail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>inputFirstName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>inputLastName</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>screenConfirm</name>
        <label>Create Contact</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>createContact</targetReference>
        </connector>
        <fields>
            <name>displayHeader</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>{!formulaHeaderText}</fieldText>
        </fields>
        <fields>
            <name>displayReceivedData</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>{!formulaReceivedDataText}</fieldText>
        </fields>
        <fields>
            <name>displayEditHeader</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>{!formulaEditSectionHeader}</fieldText>
        </fields>
        <fields>
            <name>inputFirstName</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>firstName</elementReference>
            </defaultValue>
            <fieldText>First Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>inputLastName</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>lastName</elementReference>
            </defaultValue>
            <fieldText>Last Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>inputEmail</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>email</elementReference>
            </defaultValue>
            <fieldText>Email</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>screenSuccess</name>
        <label>Contact Created</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>displaySuccess</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>{!formulaSuccessText}</fieldText>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>screenConfirm</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>accountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>firstName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>lastName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
